				<Event>
					<Id>1467384715563</Id>
					<Name><![CDATA[fillFociSizeData]]></Name>
					<X>-670</X><Y>280</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="timeout" Mode="cyclic">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[HOUR]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_HOUR]]></Unit>
						</Rate>
						<Id>1466098169994</Id>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1465977600000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[10]]></Code>
							<Unit Class="TimeUnits"><![CDATA[HOUR]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[HOUR]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[fociSizeData.reset();
fociSizeData2.reset();
fociSizeData3.reset();
fociSizeData4.reset();
cellCountsParent.reset();
cellCountsDRectangle.reset();
cellCountsDSquare.reset();
fociSizeData.allowDuplicateX(false);
fociSizeData2.allowDuplicateX(false);

//System.out.println("dup x allowed: "+ fociSizeData.duplicateXAllowed());
double checker = 0;
double fociCounter = 0;
for(int c = 0; c < 11; c++){
	//System.out.println("foci size is: \t" + c+1);
	//System.out.println("foci size count is: \t" + counts[c]);
	//System.out.println("initiallyInfectedCount: " + initiallyInfectedCount);
	
	if(initiallyInfectedCount > 0){
		fociSizeData.add((c+1),counts[c]/initiallyInfectedCount); // this stores foci size and distribution
		fociSizeData4.add((c+1),counts[c]/initiallyInfectedCount-AntiE2_Exp1[c]);
		checker += counts[c]/initiallyInfectedCount;
	}
}


for(int c = 0; c < 80; c++){
	fociSizeData2.add((c+1), counts[c]); // this stores foci size and the count of corresponding size
	fociCounter += counts[c];
}

int twelvePlusCount = 0;			//this represents all of the foci greater than size 11
for(int cc = 11; cc < 80; cc++){
	twelvePlusCount += counts[cc];
	
}

if(initiallyInfectedCount > 0){
	fociSizeData.add(12,twelvePlusCount/initiallyInfectedCount);
	fociSizeData4.add(12,twelvePlusCount/initiallyInfectedCount-AntiE2_Exp1[11]);
	checker += twelvePlusCount/initiallyInfectedCount;
}

//Merges = initiallyInfectedCount - fociCounter;

for(int i =0; i < 30; i++){
    fociSizeData3.add(counts2[i],counts3[i]); // this stores the foci size and the number of foci in each cluster
    cellCountsParent.add(i, counts4[i][0]);
    cellCountsDRectangle.add(i, counts4[i][1]);
    cellCountsDSquare.add(i, counts4[i][2]);
}

//System.out.println("initiallyInfectedCount: " + initiallyInfectedCount);
//System.out.println("foci size count is: \t");
//System.out.println(fociSizeData3);
//System.out.println(fociSizeData2);
//System.out.println("foci size distribution is: \t");
//System.out.println(fociSizeData);
//System.out.println("checker: "+checker);
//System.out.println("fociCounter: " + fociCounter);
//System.out.println("time: " + time());]]></Action>
				</Event>
