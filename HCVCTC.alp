		<!--   =========  Custom Experiment   ========  -->
		<CustomExperiment>
			<Id>1623277480739</Id>
			<Name><![CDATA[SimulationNonGUI]]></Name>
			<MaximumMemory>128</MaximumMemory>
			<CommandLineArguments><![CDATA[--cpr 12.96276288 --isr 10.8584222 --fdtim 34.31214444 --fdtnm 23.2029073 --sdtm 28.03945228 --seed 1 --output results.txt]]></CommandLineArguments>
			<VmArgs><![CDATA[]]></VmArgs>
			<Import><![CDATA[import java.io.*;]]></Import>
			<Code><![CDATA[

try {
	LineNumberReader r = new LineNumberReader(new InputStreamReader(System.in));
	try {
		
		// Process arguments 
        String[] args;
        args = getCommandLineArguments();
        // Debugging: 
        // traceln("Number of arguments:" + args.length);
        // traceln(Arrays.toString(args));
		
		int index_cpr = Arrays.asList(args).indexOf("--cpr");
		int index_isr = Arrays.asList(args).indexOf("--isr");
		int index_fdtim = Arrays.asList(args).indexOf("--fdtim");
		int index_fdtnm = Arrays.asList(args).indexOf("--fdtnm");
		//int index_fdtnsd = Arrays.asList(args).indexOf("--fdtnsd");
		int index_sdtm = Arrays.asList(args).indexOf("--sdtm");
		//int index_sdtsd = Arrays.asList(args).indexOf("--sdtsd");
		//int index_tdtsd = Arrays.asList(args).indexOf("--tdtsd");
		int index_seed = Arrays.asList(args).indexOf("--seed");
		int index_output = Arrays.asList(args).indexOf("--output");
		double cpr;
		double isr;
		double fdtim;
		double fdtnm;
		//double fdtnsd;
		double sdtm;
		//double sdtsd;
		//double tdtsd;
		long seed;
	        
	    if (index_cpr >= 0 && index_isr >= 0 && index_fdtim >= 0 && index_fdtnm >= 0 && index_sdtm >= 0 && index_seed >= 0){
	        try {
				cpr = Double.parseDouble(args[index_cpr+1]);
				traceln("cpr -> " + Double.toString(cpr));
				isr = Double.parseDouble(args[index_isr+1]);
				traceln("isr -> " + Double.toString(isr));
				fdtim = Double.parseDouble(args[index_fdtim+1]);
				traceln("fdtim -> " + Double.toString(fdtim));
				fdtnm = Double.parseDouble(args[index_fdtnm+1]);
				traceln("fdtnm -> " + Double.toString(fdtnm));
				//fdtnsd = Double.parseDouble(args[index_fdtnsd+1]);
				//traceln("fdtnsd -> " + Double.toString(fdtnsd));
				sdtm = Double.parseDouble(args[index_sdtm+1]);
				traceln("sdtm -> " + Double.toString(sdtm));
				//sdtsd = Double.parseDouble(args[index_sdtsd+1]);
				//traceln("sdtsd -> " + Double.toString(sdtsd));
				//tdtsd = Double.parseDouble(args[index_tdtsd+1]);
				//traceln("tdtsd -> " + Double.toString(tdtsd));
				seed = Long.parseLong(args[index_seed+1]);
				traceln("seed -> " + Long.toString(seed)); 
	        	
	        	// Create Engine, initialize random number generator:
				Engine engine = createEngine();
		        engine.setTimeUnit( HOUR );
		        // Fixed seed (reproducible simulation runs)
		        engine.getDefaultRandomGenerator().setSeed(seed);
		        engine.setStartTime( 0.0 );
		        engine.setStartDate( toDate( 2016, JUNE, 16, 0, 0, 0 ) );
		        // Set stop time:
		        engine.setStopTime( 72.0 );		// Set stop time:
		        
		        
			  	// Create new root object:
			    Main root = new Main( engine, null, null );

			    root.setParametersToDefaultValues();
	        	
			    
				root.cellProliferationRate = cpr;
			    root.infectionSpreadRate = isr;
			    root.firstDivisionTimeInit = fdtim;
			    root.firstDivisionTimeNoninit = fdtnm;
				//root.firstDivisionFlexNoninit = fdtnsd;
				root.secondDivisionTime = sdtm;
				//root.secondDivisionFlex = sdtsd;
				//root.thirdDivisionFlex = tdtsd;
				
				
				// Prepare Engine for simulation:
				engine.start( root );
				// Start simulation in fast mode:
				engine.runFast();
				
				// Destroy the model:
				engine.stop();
				traceln( "Iteration complete" );
	            
	           	if (index_output >=0){
					String output = args[index_output+1];
					File output_fo = new File(output);
			        String header = "size,distribution\n";
			        BufferedWriter writer = new BufferedWriter(new FileWriter(output_fo));
			        writer.write(header);
			        for (int i=0; i < root.fociSizeData.size(); i++ ){
						double foci_size = root.fociSizeData.getX(i);
						double foci_distribution = root.fociSizeData.getY(i);
						String row = Double.toString(foci_size) + "," + Double.toString(foci_distribution) + "\n";
						writer.write(row);
					}
			        writer.close();	
			        traceln("Comma-seperated simulation results saved to " + output + " .");	
				} else {
					// Verbose results of simulation
					traceln("size and foci size distribution:");
					traceln(root.fociSizeData);
    				// traceln("size and difference:");
					// traceln(root.fociSizeData4);
					traceln("size and focus number:");
			        traceln(root.fociSizeData3);
			        traceln("foci index and number of parent cells:");
			        traceln(root.cellCountsParent);
			        traceln("foci index and number of rectangle cells:");
			        traceln(root.cellCountsDRectangle);
			        traceln("foci index and number of square cells:");
			        traceln(root.cellCountsDSquare);

					traceln("Use [--output FILE] option to write results and suppress verbose message.");
				}; 
	            
	        } catch (NumberFormatException e) {
	            traceln("Cannot parse one or more required arguments.");
	        }

        } else { 
			traceln("Usage: ./HCVCTC_linux.sh ARGS [--output FILE]");
			traceln("Example: ./HCVCTC_linux.sh --cpr 10 --isr 10 --fdtim 10 --fdtnm 10 --sdtm 10 --seed 1 --output results.txt");
			traceln("\nRequired arguments:");
			traceln("  --cpr \t Cell Proliferation Rate");
			traceln("  --isr \t Infection Spread Rate");
			traceln("  --fdtim \t Mean of First Division Time for Initial Cells");
			traceln("  --fdtnm \t Mean of First Division Time for Non-Initial Cells");
			//traceln("  --fdtnsd \t SD of First Division Time for Non-Initial Cells");
			traceln("  --sdtm \t Mean of Second Division Time");
			//traceln("  --sdtsd \t SD of Second Division Time");
			//traceln("  --tdtsd \t SD of Third Division Time");
			traceln("  --seed \t Fixed Seed Value");
			traceln("\nOptional:");
			traceln("  --output FILE \t write output file to this (relative or absolute) path, silently overwrites any existing file with the same name. if unspecified, verbose message of simulation will show");      
		}       

	} finally {
		r.close();
	}
} catch (java.io.IOException e) {
	e.printStackTrace();
}
]]></Code>
