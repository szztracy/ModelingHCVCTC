s += "thirdDivisionTime\t" + format( thirdDivisionTime ) + "\n";
s += "thirdDivisionFlex\t" + format( thirdDivisionFlex ) + "\n";
s += "infectionSpreadRate\t" + format( getBestParamValue( _oqvar_infectionSpreadRate ) ) + "\n";
s += "Dampener\t" + format( Dampener ) + "\n";
s += "firstDivisionTimeNoninit\t" + format( firstDivisionTimeNoninit ) + "\n";
s += "firstDivisionFlexNoninit\t" + format( firstDivisionFlexNoninit ) + "\n";
s += "cellProliferationRate\t" + format( cellProliferationRate ) + "\n";

copyToClipboard( s );]]></ActionCode>
