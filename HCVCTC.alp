					<Body><![CDATA[InfectionData.println(">foci size distribution");
InfectionData.println("size	number");
for(int i =1; i < 30; i++){
	InfectionData.println(i + "	" + counts[i-1]);
}

InfectionData.println("-------------------------");
InfectionData.println("size numberofInitiallyInfectedCellInTheFoci");
for(int i =0; i < 30; i++){
    InfectionData.println(counts2[i] + " " + counts3[i]);
}
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1608335063284</Id>
					<Name><![CDATA[ExportFociSizeDistribution]]></Name>
					<X>-1140</X><Y>-80</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[InfectionData.println("size	distribution");
for(int i =1; i < 13; i++){
	InfectionData.println(i + "	" + counts[i-1]/initiallyInfectedCount);
}

InfectionData.println("size	difference");
for(int i =1; i < 13; i++){
	InfectionData.println(i + "	" + (counts[i-1]/initiallyInfectedCount-AntiE2_Exp1[i-1]));
}

InfectionData.println("size focusNumber");
for(int i =1; i < 31; i++){
	InfectionData.println(counts2[i-1] + "	" + counts3[i-1]);
}
]]></Body>
