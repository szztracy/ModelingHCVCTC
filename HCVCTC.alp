						<ActionCode><![CDATA[String s = "";
s += "FFUs\t" + format( FFUs ) + "\n";
s += "startingCellCount\t" + format( startingCellCount ) + "\n";
s += "E2TreatmentTime\t" + format( E2TreatmentTime ) + "\n";
s += "firstDivisionTimeInit\t" + format( getBestParamValue( _oqvar_firstDivisionTimeInit ) ) + "\n";
s += "firstDivisionFlexInit\t" + format( firstDivisionFlexInit ) + "\n";
s += "secondDivisionTime\t" + format( getBestParamValue( _oqvar_secondDivisionTime ) ) + "\n";
s += "secondDivisionFlex\t" + format( getBestParamValue( _oqvar_secondDivisionFlex ) ) + "\n";
s += "thirdDivisionTime\t" + format( getBestParamValue( _oqvar_thirdDivisionTime ) ) + "\n";
s += "thirdDivisionFlex\t" + format( getBestParamValue( _oqvar_thirdDivisionFlex ) ) + "\n";
s += "infectionSpreadRate\t" + format( getBestParamValue( _oqvar_infectionSpreadRate ) ) + "\n";
s += "Dampener\t" + format( Dampener ) + "\n";
s += "firstDivisionTimeNoninit\t" + format( firstDivisionTimeNoninit ) + "\n";
s += "firstDivisionFlexNoninit\t" + format( firstDivisionFlexNoninit ) + "\n";
s += "cellProliferationRate\t" + format( cellProliferationRate ) + "\n";

copyToClipboard( s );]]></ActionCode>
