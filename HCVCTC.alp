					<Properties Source="1466113369654" Target="1466113380371" Trigger="timeout">
						<Action><![CDATA[xMinus.setColor(black);
xPlus.setColor(black);
main.cellCount ++;]]></Action>
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[uniform(main.firstDivisionFlexInit,(main.firstDivisionTimeInit))]]></Code>
							<Unit Class="TimeUnits"><![CDATA[HOUR]]></Unit>
