			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[List<int>]]></ReturnType>
					<Id>1467384493130</Id>
					<Name><![CDATA[countFociSize]]></Name>
					<X>-670</X><Y>100</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[List<Cell> unchecked = new ArrayList<Cell>();
List<Cell> checked = new ArrayList<Cell>();
List<Cell> investigated = new ArrayList<Cell>();
List<Cell> neighbors = new ArrayList<Cell>();
counts2 = new int[200]; //count of foci sizes
counts3 = new int[200];
counts4 = new int[200][3]; //count of cell types

int k = 0;

for (Cell c : initiallyInfectedCells)
{
	if(!investigated.contains(c))
	{
		unchecked.add(c);
	}
	while(unchecked.size() > 0)
	{
		checked.add(unchecked.get(0));
		investigated.add(unchecked.get(0));
		neighbors = NeighGet(unchecked.get(0));//gets all Moore neighbors
		for(Cell d : neighbors)
		{
			if(!checked.contains(d) && !unchecked.contains(d))
				unchecked.add(d);
				//if(k == 0){
				//d.q1.setFillColor(yellow);
				//d.q2.setFillColor(yellow);
				//d.q3.setFillColor(yellow);
				//d.q4.setFillColor(yellow);
				//}
		}
		neighbors.clear();
		unchecked.remove(unchecked.get(0));
	}
	
	int fociSize = 0;
	double temp = 0;
	int numberOfInitiallyInfectedCellsInAFoci = 0;
	for (Cell q : checked){
		if(q.inState( Cell.A ) && q.q1iStatus == 3){
			fociSize++;
			counts4[k][0]++;
		}else if(q.inState( Cell.B )){
			if(q.q1iStatus == 3){
				fociSize++;
				counts4[k][1]++;
			}
			if(q.q2iStatus == 3){
				fociSize++;
				counts4[k][1]++;
			}
		}else if(q.inState( Cell.C )){
			if(q.q1iStatus == 3){
				fociSize++;
				counts4[k][1]++;
			}
			if(q.q3iStatus == 3){
				fociSize++;
				counts4[k][1]++;
			}
		}else if(q.inState( Cell.D )){
			if(q.q2iStatus == 3){
				fociSize++;
				counts4[k][1]++;
			}
			if(q.q1iStatus == 3){
				fociSize++;
				counts4[k][2]++;
			}
			if(q.q4iStatus == 3){
				fociSize++;
				counts4[k][2]++;
			}
		}else if(q.inState( Cell.Ee )){
			if(q.q1iStatus == 3){
				fociSize++;
				counts4[k][1]++;
			}
			if(q.q2iStatus == 3){
				fociSize++;
				counts4[k][2]++;
			}
			if(q.q3iStatus == 3){
				fociSize++;
				counts4[k][2]++;
			}
		}else if(q.inState( Cell.F )){
			if(q.q3iStatus == 3){
				fociSize++;
				counts4[k][1]++;
			}
			if(q.q1iStatus == 3){
				fociSize++;
				counts4[k][2]++;
			}
			if(q.q2iStatus == 3){
				fociSize++;
				counts4[k][2]++;
			}
		}else if(q.inState( Cell.G )){
			if(q.q1iStatus == 3){
				fociSize++;
				counts4[k][1]++;
			}
			if(q.q3iStatus == 3){
				fociSize++;
				counts4[k][2]++;
			}
			if(q.q4iStatus == 3){
				fociSize++;
				counts4[k][2]++;
			}
		}else if(q.inState( Cell.H )){
			if(q.q1iStatus == 3){
				fociSize++;
				counts4[k][2]++;
			}
			if(q.q2iStatus == 3){
				fociSize++;
				counts4[k][2]++;
			}
			if(q.q3iStatus == 3){
				fociSize++;
				counts4[k][2]++;
			}
			if(q.q4iStatus == 3){
				fociSize++;
				counts4[k][2]++;
			}
		}	
		
		if (initiallyInfectedCells.contains(q)){
		 numberOfInitiallyInfectedCellsInAFoci++;
		}
	}
	
	if(fociSize > 0){
		counts2[k] = fociSize;
		counts3[k] = numberOfInitiallyInfectedCellsInAFoci;
		double fociSizeConverted = fociSize;
		double numberOfInitiallyInfectedCellsInAFociConverted = numberOfInitiallyInfectedCellsInAFoci;
		temp = (fociSizeConverted/numberOfInitiallyInfectedCellsInAFociConverted);
		fociSizeConverted = Math.round(temp);
		int fociSize2 = (int)fociSizeConverted;
		//System.out.println("initiallyInfectedCountModifiedDueToFociMerging: " + fociSize2);
		FociSizes.add(fociSize2);
		//System.out.println("initiallyInfectedCountModifiedDueToFociMerging: " + numberOfInitiallyInfectedCellsInAFoci);
		
		k++;

		numberOfInitiallyInfectedCellsInAFoci = 0;
		fociSize = 0;
	}

	unchecked.clear();
	checked.clear();
	investigated.clear();

}


//investigated.clear();
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1467384493132</Id>
					<Name><![CDATA[getFociCount]]></Name>
					<X>-670</X><Y>220</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[counts = new int[80];
for(int c : FociSizes){
	if(c>0){
		if(c < 80){
		counts[c-1]++;}
		else{ counts[79]++;}
	}
}

FociSizes.clear();]]></Body>
