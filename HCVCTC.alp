	if(north.q3iStatus == 3 || north.q4iStatus == 3){
		this.q1.setFillColor(lime);
		this.q2.setFillColor(lime);
		this.q1iStatus = 1;
		this.q2iStatus = 1;
	}
}
if((Cell)this.getAgentNextToMe(WEST) != null){
	Cell west = (Cell)this.getAgentNextToMe(WEST);
