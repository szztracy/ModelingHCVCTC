				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[List<Cell>]]></ReturnType>
					<Id>1467384493136</Id>
					<Name><![CDATA[NeighGet]]></Name>
					<X>-670</X><Y>130</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[ourCell]]></Name>
						<Type><![CDATA[Cell]]></Type>
					</Parameter>
					<Body><![CDATA[List<Cell> neighbors = new ArrayList<Cell>();
List<Cell> checked = new ArrayList<Cell>();
			
			if( (Cell)ourCell.getAgentNextToMe(NORTH) != null)
				neighbors.add( (Cell)ourCell.getAgentNextToMe(NORTH));
			if( (Cell)ourCell.getAgentNextToMe(NORTHEAST) != null)
				neighbors.add( (Cell)ourCell.getAgentNextToMe(NORTHEAST));
			if( (Cell)ourCell.getAgentNextToMe(EAST) != null)
				neighbors.add( (Cell)ourCell.getAgentNextToMe(EAST));
			if( (Cell)ourCell.getAgentNextToMe(SOUTHEAST) != null)
				neighbors.add( (Cell)ourCell.getAgentNextToMe(SOUTHEAST));
			if( (Cell)ourCell.getAgentNextToMe(SOUTH) != null)
				neighbors.add( (Cell)ourCell.getAgentNextToMe(SOUTH));
			if( (Cell)ourCell.getAgentNextToMe(SOUTHWEST) != null)
				neighbors.add( (Cell)ourCell.getAgentNextToMe(SOUTHWEST));
			if( (Cell)ourCell.getAgentNextToMe(WEST) != null)
				neighbors.add( (Cell)ourCell.getAgentNextToMe(WEST));
			if( (Cell)ourCell.getAgentNextToMe(NORTHWEST) != null)
				neighbors.add( (Cell)ourCell.getAgentNextToMe(NORTHWEST));
			
for (Cell t : neighbors)
{
  //If NORTH agent
  if ((ourCell.q1iStatus == 3 || ourCell.q2iStatus == 3) && (t.q3iStatus == 3 || t.q4iStatus == 3)) {
    checked.add(t);
    //t.q2.setFillColor(yellow);
  }
  //If NORTHEAST agent
  if ((ourCell.q1iStatus == 3) && (t.q3iStatus == 3)) {
    checked.add(t);
    //t.q2.setFillColor(yellow);
  }
  //If EAST agent
  if ((ourCell.q1iStatus == 3 || ourCell.q4iStatus == 3) && (t.q2iStatus == 3 || t.q3iStatus == 3)) {
    checked.add(t);
    //t.q2.setFillColor(yellow);
  }
  //If SOUTHEAST agent
  if ((ourCell.q4iStatus == 3) && (t.q2iStatus == 3)) {
    checked.add(t);
    //t.q2.setFillColor(yellow);
  }
  //If SOUTH agent
  if ((ourCell.q3iStatus == 3 || ourCell.q4iStatus == 3) && (t.q1iStatus == 3 || t.q2iStatus == 3)) {
    checked.add(t);
    //t.q2.setFillColor(yellow);
  }
  //If SOUTHWEST agent
  if ((ourCell.q3iStatus == 3) && (t.q1iStatus == 3)) {
    checked.add(t);
    //t.q2.setFillColor(yellow);
  }
  //If WEST agent
  if ((ourCell.q2iStatus == 3 || ourCell.q3iStatus == 3) && (t.q1iStatus == 3 || t.q4iStatus == 3)) {
    checked.add(t);
    //t.q2.setFillColor(yellow);
  }
  //If NORTHWEST agent
  if ((ourCell.q2iStatus == 3) && (t.q4iStatus == 3)) {
    checked.add(t);
    //t.q2.setFillColor(yellow);
  }				
}
return checked;]]></Body>
				</Function>
