					<Action><![CDATA[
if(q1iStatus == 1 || q2iStatus == 1 || q3iStatus == 1 || q4iStatus == 1 )
{
	//infection of full cell
	if(statechart.isStateActive(Cell.A))
	{
		q1iStatus = q2iStatus = q3iStatus = q4iStatus = 3;
	}
	
	
	if(statechart.isStateActive(Cell.B))
	{
		if(q1iStatus == 1 || q4iStatus == 1){ q1iStatus = 3; q4iStatus = 3;}
		if(q2iStatus == 1 || q3iStatus == 1){ q2iStatus = 3; q3iStatus = 3;}
	}
	if(statechart.isStateActive(Cell.C))
	{
		if(q1iStatus == 1 || q2iStatus == 1){ q1iStatus = 3; q2iStatus = 3;}
		if(q3iStatus == 1 || q4iStatus == 1){ q3iStatus = 3; q4iStatus = 3;}
	}
	if(statechart.isStateActive(Cell.D))
	{
		if(q2iStatus == 1 || q3iStatus == 1){ q2iStatus = 3; q3iStatus = 3;}
		if(q1iStatus == 1){ q1iStatus = 3;  q1.setFillColor(red);}
		if(q4iStatus == 1){ q4iStatus = 3;  q4.setFillColor(red);}
	}
	if(statechart.isStateActive(Cell.Ee))
	{
		if(q1iStatus == 1 || q4iStatus == 1){ q1iStatus = 3; q4iStatus = 3;}
		if(q2iStatus == 1){ q2iStatus = 3;  q2.setFillColor(red);}
		if(q3iStatus == 1){ q3iStatus = 3;  q3.setFillColor(red);}
	}
	if(statechart.isStateActive(Cell.F))
	{
		if(q3iStatus == 1 || q4iStatus == 1){ q3iStatus = 3; q4iStatus = 3;}
		if(q1iStatus == 1){ q1iStatus = 3;  q1.setFillColor(red);}
		if(q2iStatus == 1){ q2iStatus = 3;  q2.setFillColor(red);}
	}
	if(statechart.isStateActive(Cell.G))
	{
		if(q1iStatus == 1 || q2iStatus == 1){ q1iStatus = 3; q2iStatus = 3;}
		if(q3iStatus == 1){ q3iStatus = 3;  q3.setFillColor(red);}
		if(q4iStatus == 1){ q4iStatus = 3;  q4.setFillColor(red);}
	}
	if(statechart.isStateActive(Cell.H))
	{
		if(q1iStatus == 1){ q1iStatus = 3; q1.setFillColor(red);}
		if(q2iStatus == 1){ q2iStatus = 3; q2.setFillColor(red);}
		if(q3iStatus == 1){ q3iStatus = 3; q3.setFillColor(red);}
		if(q4iStatus == 1){ q4iStatus = 3; q4.setFillColor(red);}
	}

}
]]></Action>
				</Event>
			</Events>
			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1466436301845</Id>
					<Name><![CDATA[initialInfectionF]]></Name>
					<X>360</X><Y>-110</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if(statechart.isStateActive(Cell.A))
{
	q1iStatus = 3;
	q1.setFillColor(red);
	q2iStatus = 3;
	q2.setFillColor(red);
	q3iStatus = 3;
	q3.setFillColor(red);
	q4iStatus = 3;
	q4.setFillColor(red);
	main.initiallyInfectedCount++;
	rectangle.setLineColor(gold);
}
if(statechart.isStateActive(Cell.B))
{
	boolean ran = randomTrue(.5);
	if (ran){
		q1iStatus = 3;
		q1.setFillColor(red);
		q4iStatus = 3;
		q4.setFillColor(red);
		main.initiallyInfectedCount++;
		q2iStatus = 1;
		q2.setFillColor(lime);
		q3iStatus = 1;
		q3.setFillColor(lime);
		rectangle.setLineColor(gold);
	}else{
		q2iStatus = 3;
		q2.setFillColor(red);
		q3iStatus = 3;
		q3.setFillColor(red);
		main.initiallyInfectedCount++;
		q1iStatus = 1;
		q1.setFillColor(lime);
		q4iStatus = 1;
		q4.setFillColor(lime);
		rectangle.setLineColor(gold);
	}
}
if(statechart.isStateActive(Cell.C))
{
	boolean ran = randomTrue(.5);
	if (ran){
		q1iStatus = 3;
		q1.setFillColor(red);
		q2iStatus = 3;
		q2.setFillColor(red);
		main.initiallyInfectedCount++;
		q3iStatus = 1;
		q3.setFillColor(lime);
		q4iStatus = 1;
		q4.setFillColor(lime);
		rectangle.setLineColor(gold);
	}else{
		q3iStatus = 3;
		q3.setFillColor(red);
		q4iStatus = 3;
		q4.setFillColor(red);
		main.initiallyInfectedCount++;
		q1iStatus = 1;
		q1.setFillColor(lime);
		q2iStatus = 1;
		q2.setFillColor(lime);
		rectangle.setLineColor(gold);
	}
}
main.initiallyInfectedCells.add(this);

//System.out.println("initiallyInfectedCount: " + main.initiallyInfectedCount);
]]></Body>
				</Function>
